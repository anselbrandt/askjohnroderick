[Unit]
Description=Ask John Roderick API
After=network.target

[Service]
User=ansel
WorkingDirectory=/home/ansel/dev/askjohnroderick/backend
ExecStart=/home/ansel/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
