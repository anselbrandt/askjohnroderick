#!/usr/bin/env bash
#
# Refuse a commit that would not pass scripts/check.sh.
#
# Deliberately thin: the checks themselves live in check.sh so that what runs
# here and what you run while working are the same thing. A hook with its own
# copy drifts, and then passes locally and fails in the hook, or worse the
# reverse.
#
# Version-controlled rather than left in .git/hooks, which is not. Activate it
# once per clone:
#
#     git config core.hooksPath scripts/hooks
#
# Checks, never rewrites: a hook that reformats behind you changes what you are
# committing after you have read it. `git commit --no-verify` skips it.
#
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# The checks read the working tree, not the staged content. Where the two
# differ the result can disagree with what is being committed, so say so
# rather than quietly testing the wrong thing.
partial=$(git diff --name-only -- $(echo "$staged" | tr '\n' ' ') 2>/dev/null)
if [ -n "$partial" ]; then
  printf '  note: these files have unstaged changes; checks read the working tree:\n'
  printf '    %s\n' $partial
fi

# Only the halves this commit touches.
which=""
echo "$staged" | grep -q '^frontend/' && which="frontend"
echo "$staged" | grep -q '^backend/'  && which="${which:+}backend"
if echo "$staged" | grep -q '^frontend/' && echo "$staged" | grep -q '^backend/'; then
  which=""
fi

scripts/check.sh $which
